# App
APP_NAME=FiscalizaPay API
ENVIRONMENT=development
PORT=8000

# Use a strong random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-use-a-long-random-secret
JWT_EXPIRES_MINUTES=60

# CORS: comma-separated frontend origins.
# Local frontend default:
CORS_ORIGINS=http://localhost:3000

# Hosts accepted by the API. Use your domain in production.
# Example: api.seudominio.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL.
# Docker compose uses host "db".
DATABASE_URL=postgresql+psycopg://fiscalizapay:fiscalizapay_dev_password@db:5432/fiscalizapay

# Wallet auth
AUTH_NONCE_EXPIRES_MINUTES=10
CHAIN_ID=80002

# Blockchain placeholders. Smart contract is intentionally disabled for now.
EXPLORER_URL=https://amoy.polygonscan.com
CONTRACT_ADDRESS=
BLOCKCHAIN_ENABLED=false
