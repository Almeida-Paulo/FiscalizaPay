# FiscalizaPay Backend - environment example
# Copy this file to ".env" and adjust values for your local environment.
# Do not commit real secrets, private keys, mnemonics or production credentials.

# App
APP_NAME=FiscalizaPay API
ENVIRONMENT=development
PORT=8000

# Database
# Docker Compose uses service host "db".
DATABASE_URL=postgresql+psycopg://fiscalizapay:fiscalizapay_dev_password@db:5432/fiscalizapay
# If running the API outside Docker, use a local PostgreSQL host instead:
# DATABASE_URL=postgresql+psycopg://fiscalizapay:fiscalizapay_dev_password@localhost:5432/fiscalizapay

# JWT / Auth
# Must be at least 32 characters. Replace in every real environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-local-jwt-secret-at-least-32-chars
JWT_EXPIRES_MINUTES=60
JWT_ALGORITHM=HS256
AUTH_NONCE_EXPIRES_MINUTES=10

# API / Security
# Comma-separated frontend origins allowed by CORS.
# Include 3001 as well: Next.js falls back to that port when 3000 is busy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Hosts accepted by the API in production mode.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Blockchain / Web3
# Real writing is disabled by default to avoid spending faucet funds during demos.
# Enable only when RPC_URL, OPERATOR_PRIVATE_KEY and CONTRACT_ADDRESS are configured.
CHAIN_ID=11155111
EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_ENABLED=false
CONTRACT_ADDRESS=0xC39B2598EF9eaDc8F5C4e670893544e7Dfc52f83
RPC_URL=
OPERATOR_PRIVATE_KEY=
BLOCKCHAIN_TX_TIMEOUT_SECONDS=120
