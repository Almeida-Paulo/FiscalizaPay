# FiscalizaPay Backend - environment example
# Copy this file to ".env" and adjust values for your local environment.
# Do not commit real secrets, private keys, mnemonics or production credentials.

# App
APP_NAME=FiscalizaPay API
ENVIRONMENT=development
PORT=8000

# Database
# Docker Compose uses service host "db".
DATABASE_URL=postgresql+psycopg://fiscalizapay:fiscalizapay_dev_password@db:5432/fiscalizapay
# If running the API outside Docker, use a local PostgreSQL host instead:
# DATABASE_URL=postgresql+psycopg://fiscalizapay:fiscalizapay_dev_password@localhost:5432/fiscalizapay

# JWT / Auth
# Must be at least 32 characters. Replace in every real environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-local-jwt-secret-at-least-32-chars
JWT_EXPIRES_MINUTES=60
JWT_ALGORITHM=HS256
AUTH_NONCE_EXPIRES_MINUTES=10

# API / Security
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosts accepted by the API in production mode.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Blockchain / Web3
# Keep BLOCKCHAIN_ENABLED=false until a real smart contract is deployed.
CHAIN_ID=80002
EXPLORER_URL=https://amoy.polygonscan.com
BLOCKCHAIN_ENABLED=false
CONTRACT_ADDRESS=
