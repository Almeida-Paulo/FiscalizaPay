# FiscalizaPay Web3 — Frontend Environment Variables
# Copie este arquivo para .env.local e preencha os valores

# URL base da API backend
# NEXT_PUBLIC_API_BASE_URL tem prioridade sobre NEXT_PUBLIC_API_URL (mantido por retrocompatibilidade)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000  # alias legado — use API_BASE_URL

# Sepolia chain ID (11155111) | Polygon Amoy (80002)
NEXT_PUBLIC_CHAIN_ID=11155111

# Endereço do smart contract deployado na Sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS=0xC39B2598EF9eaDc8F5C4e670893544e7Dfc52f83

# Ativar mocks locais: true = mocks | false = API real
# NEXT_PUBLIC_USE_MOCKS tem prioridade; NEXT_PUBLIC_ENABLE_MOCKS mantido por retrocompatibilidade
# Qualquer um definido como "false" desativa os mocks
NEXT_PUBLIC_USE_MOCKS=true
# NEXT_PUBLIC_ENABLE_MOCKS=true  # alias legado — use USE_MOCKS

# URL base do block explorer
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# WalletConnect Project ID (obrigatório para conexão via QR code / mobile)
# Obtenha gratuitamente em: https://cloud.walletconnect.com
# Sem este ID, apenas MetaMask (browser extension) funcionará
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
